{
  "name": "contract-driven-delivery",
  "version": "4.0.0",
  "description": "Contract-driven delivery kit for AI coding agents with deterministic context indexes, manifest-backed read-scope governance, and orchestrated contracts-first delivery.",
  "keywords": [
    "contract-driven",
    "claude-code",
    "codex",
    "ai-agents",
    "sdd",
    "tdd",
    "specs",
    "contracts",
    "brownfield",
    "multi-agent",
    "cdd-kit"
  ],
  "license": "MIT",
  "author": "Contract-Driven Delivery Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beabigegg/contract-driven-delivery-kit.git"
  },
  "bugs": {
    "url": "https://github.com/beabigegg/contract-driven-delivery-kit/issues"
  },
  "homepage": "https://github.com/beabigegg/contract-driven-delivery-kit#readme",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cdd-kit": "bin/cdd.js"
  },
  "exports": {
    ".": {
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "check:mojibake": "node tools/check-mojibake.mjs",
    "check:lockfile": "node tools/check-lockfile-sync.mjs",
    "pretest": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check:lockfile && npm run check:mojibake && node build.js && tsc --noEmit && vitest run",
    "postinstall": "node bin/postinstall.js",
    "contract:client": "cdd-kit openapi export --out contracts/api/openapi.json && npx --yes openapi-typescript contracts/api/openapi.json -o src/api/types.ts",
    "contract:client:check": "cdd-kit openapi export --check --out contracts/api/openapi.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "@babel/parser": "^7.25.0",
    "@vue/compiler-sfc": "^3.4.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/picomatch": "^3.0.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}

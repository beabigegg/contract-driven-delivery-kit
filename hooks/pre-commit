#!/bin/sh
# cdd-kit-managed-block-start
# Auto-runs cdd-kit gate for any change folder touched in this commit.
# Generated by: cdd-kit install-hooks (re-run to update).
# Bypass with --no-verify (NOT recommended; defeats AI process enforcement).
#
# NOT --strict, deliberately. --strict is MERGE-grade: among other things it
# refuses an autonomous acceptance receipt and demands the human hash-lock
# (gate-acceptance.ts: `autonomousAccepted = autonomousReceipt && !strict`).
# That belongs at the merge boundary, and the CI workflow already puts it there
# -- contract-driven-gates.yml adds --strict only on `push`, never on a PR.
# Applying it to every local commit instead made the only way to commit
# work-in-progress `--no-verify`, which disables this hook entirely: a control
# bypassed every time is not a control, it is a tax that trains people to reach
# for the bypass. The plain gate still runs here and still fails on a stub, an
# unfilled placeholder, missing test evidence, or an empty acceptance oracle.
# Set CDD_PRECOMMIT_STRICT=1 to opt back in.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

change_ids=$(echo "$staged" | grep -oE '^specs/changes/[^/]+' | sort -u | sed 's|specs/changes/||')
[ -z "$change_ids" ] && exit 0

strict_flag=""
[ -n "$CDD_PRECOMMIT_STRICT" ] && strict_flag="--strict"

for id in $change_ids; do
  echo "[cdd-kit] running gate for change: $id"
  if ! cdd-kit gate "$id" $strict_flag; then
    echo "[cdd-kit] gate failed for $id — commit rejected."
    echo "[cdd-kit] fix issues above; --no-verify bypasses but defeats the kit."
    exit 1
  fi
done
# cdd-kit-managed-block-end
